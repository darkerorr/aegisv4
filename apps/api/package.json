{
  "name": "@aegis/api",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "prisma db push --skip-generate && tsx src/server.ts",
    "build": "node ../../scripts/ensure-prisma-client.mjs && tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "tsc --noEmit -p tsconfig.json",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@aegis/agent-runtime": "workspace:*",
    "@aegis/config": "workspace:*",
    "@aegis/providers": "workspace:*",
    "@aegis/supervisor": "workspace:*",
    "@aegis/tools": "workspace:*",
    "@aegis/types": "workspace:*",
    "@octokit/app": "^16.1.2",
    "@octokit/rest": "^22.0.1",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "prisma": "^6.15.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
