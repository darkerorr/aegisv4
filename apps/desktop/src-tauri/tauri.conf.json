{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aegis Desktop",
  "version": "0.3.0",
  "identifier": "com.aegis.desktop",
  "build": { "beforeDevCommand": "pnpm dev", "beforeBuildCommand": "pnpm build", "devUrl": "http://127.0.0.1:1420", "frontendDist": "../dist" },
  "app": { "windows": [{ "title": "Aegis Desktop", "width": 1280, "height": 820, "minWidth": 760, "minHeight": 500 }], "security": { "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:4000 http://localhost:4000 https://api.aegis.example; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data: blob: https:" } },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.icns"], "createUpdaterArtifacts": false }
}
