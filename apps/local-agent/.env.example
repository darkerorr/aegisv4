# Aegis Local Agent — device-side execution service
# Binds to loopback only. Authenticate every request with "Authorization: Bearer <token>".

# Address and port (loopback only)
AEGIS_LOCAL_AGENT_HOST=127.0.0.1
AEGIS_LOCAL_AGENT_PORT=4150

# Where the per-device token and trusted workspaces are stored
AEGIS_LOCAL_AGENT_DATA_DIR=
# Override the token instead of generating one (any non-empty value)
AEGIS_LOCAL_AGENT_TOKEN=

# Allowed browser origins for CORS
AEGIS_LOCAL_AGENT_ORIGINS=http://127.0.0.1:3000,http://localhost:1420

# Policy limits
AEGIS_LOCAL_AGENT_MAX_FILE_BYTES=307200
AEGIS_LOCAL_AGENT_MAX_TOOL_TURNS=12
AEGIS_LOCAL_AGENT_TERMINAL_TIMEOUT_MS=60000
