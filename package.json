{
  "name": "aegis",
  "version": "0.3.0",
  "description": "Aegis ecosystem: Web, App, API and CLI for local and remote AI workspaces.",
  "type": "module",
  "bin": {
    "aegis": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    ".env.example"
  ],
  "scripts": {
    "predev": "pnpm --filter @aegis/supervisor build",
    "dev": "node scripts/supervisor.mjs",
    "dev:web": "pnpm --filter @aegis/web dev",
    "dev:supervisor": "node scripts/supervisor.mjs",
    "start:web": "pnpm --filter @aegis/web start --port 3000",
    "start:api": "node apps/api/dist/server.js",
    "dev:local-agent": "pnpm --filter @aegis/local-agent dev",
    "start:local-agent": "pnpm --filter @aegis/local-agent start",
    "build:web": "node scripts/web/ensure-web-build.mjs --force",
    "preview:web": "node scripts/web/ensure-web-build.mjs && pnpm start:web",
    "prewarm:web": "node scripts/web/prewarm-routes.mjs",
    "dev:api": "pnpm --filter @aegis/api dev",
    "dev:desktop": "pnpm --filter @aegis/desktop dev",
    "dev:cli": "tsx src/index.ts",
    "build:cli": "tsc -p tsconfig.json",
    "build": "npm run build:cli && pnpm -r --workspace-concurrency=1 --if-present build",
    "start": "node dist/index.js",
    "test": "pnpm -r --workspace-concurrency=1 --if-present test",
    "lint": "pnpm -r --workspace-concurrency=1 --if-present lint",
    "format": "prettier --write ."
  },
  "keywords": [
    "ai",
    "coding-assistant",
    "ollama",
    "lm-studio",
    "desktop",
    "web"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.12.4",
  "dependencies": {
    "@aegis/supervisor": "workspace:*",
    "@inquirer/prompts": "^7.3.3",
    "boxen": "^8.0.1",
    "commander": "^13.1.0",
    "dotenv": "^16.4.7",
    "ora": "^8.2.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "^22.13.10",
    "concurrently": "^9.2.1",
    "eslint": "^9.35.0",
    "prettier": "^3.6.2",
    "typescript-eslint": "^8.42.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
